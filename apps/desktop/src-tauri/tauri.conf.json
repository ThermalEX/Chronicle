{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronicle",
  "version": "1.2.1",
  "identifier": "com.thermalex.chronicle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chronicle",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
